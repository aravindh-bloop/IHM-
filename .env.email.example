# ==================== EMAIL CONFIGURATION ====================
# Email service settings for sending invoices and notifications
# For Gmail, you need to:
# 1. Enable 2-Factor Authentication
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the App Password as MAIL_PASSWORD

# Email account credentials
IHM_BACKEND_MAIL_USERNAME=your-email@gmail.com
IHM_BACKEND_MAIL_PASSWORD=your-app-password-here

# SMTP server settings
IHM_BACKEND_MAIL_SERVER=smtp.gmail.com
IHM_BACKEND_MAIL_PORT=587
IHM_BACKEND_MAIL_FROM=your-email@gmail.com
IHM_BACKEND_MAIL_FROM_NAME=FUMU - Food Management System

# Security settings
IHM_BACKEND_MAIL_STARTTLS=True
IHM_BACKEND_MAIL_SSL_TLS=False

# Admin email for receiving notifications
IHM_BACKEND_ADMIN_EMAIL=admin@admin.com

# ==================== OTHER EMAIL PROVIDERS ====================
# For Outlook/Office365:
# IHM_BACKEND_MAIL_SERVER=smtp.office365.com
# IHM_BACKEND_MAIL_PORT=587

# For Yahoo Mail:
# IHM_BACKEND_MAIL_SERVER=smtp.mail.yahoo.com
# IHM_BACKEND_MAIL_PORT=587

# For Custom SMTP:
# IHM_BACKEND_MAIL_SERVER=your-smtp-server.com
# IHM_BACKEND_MAIL_PORT=587 or 465
# IHM_BACKEND_MAIL_SSL_TLS=True (for port 465)
